<Window x:Class="PrivacyBrowser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy Browser" Icon="Assets/Icons/app-icon-256.png" Height="660" Width="980" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3E1" BorderThickness="0,0,0,1" Padding="24,17">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Privacy Browser" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Browser-scoped provider connection" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="ControlsButton" Content="Controls" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="ControlsButton_Click" AutomationProperties.Name="Open privacy controls" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ControlColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Text="Connection" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="24" Margin="0,10,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ConnectionStatusText" Text="Starting backend…" FontSize="30" FontWeight="Bold" />
                        <TextBlock x:Name="ConnectionDetailText" Grid.Row="1" Text="The native controller is preparing Myst."
                                   Foreground="{StaticResource TextSecondary}" Margin="0,8,0,20" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button x:Name="LaunchBrowserButton" Content="Launch browser" Click="LaunchBrowserButton_Click" IsEnabled="False" />
                            <Button x:Name="DisconnectMainButton" Content="Disconnect" Click="DisconnectButton_Click" IsEnabled="False"
                                    Background="#6E7975" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Privacy boundary" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="24" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Only this Mullvad Browser profile uses the provider proxy." FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Margin="0,9,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                   Text="The native window owns the backend process directly. No browser-based control page or UI listener is used. Other Windows applications keep their normal network path." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="ControlPanel" Grid.Column="1" Background="{StaticResource CardBackground}" CornerRadius="12"
                    Padding="20" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Privacy controls" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Terms" Margin="0,22,0,5" FontWeight="SemiBold" />
                        <CheckBox x:Name="AcceptTermsCheckBox" Click="AcceptTermsCheckBox_Click"
                                  Content="I accept the current Mysterium consumer terms"
                                  Foreground="{StaticResource TextSecondary}" />
                        <TextBlock x:Name="TermsVersionText" Margin="22,4,0,0" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="Identity" Margin="0,18,0,5" FontWeight="SemiBold" />
                        <TextBlock x:Name="IdentityText" Text="Checking…" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,8">
                            <Button x:Name="CreateIdentityButton" Content="Create identity" Click="CreateIdentityButton_Click" />
                            <Button x:Name="RegisterIdentityButton" Content="Register" Click="RegisterIdentityButton_Click" IsEnabled="False" />
                        </WrapPanel>

                        <TextBlock Text="Provider" Margin="0,14,0,5" FontWeight="SemiBold" />
                        <ComboBox x:Name="ProviderComboBox" Height="34" DisplayMemberPath="DisplayName" />
                        <WrapPanel Margin="0,8,0,8">
                            <Button x:Name="RefreshProvidersButton" Content="Refresh" Click="RefreshProvidersButton_Click" />
                            <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" IsEnabled="False" />
                            <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click" IsEnabled="False"
                                    Background="#6E7975" />
                        </WrapPanel>

                        <TextBlock Text="Activity" Margin="0,14,0,5" FontWeight="SemiBold" />
                        <TextBox x:Name="ActivityText" Height="155" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" BorderBrush="#D8DFDC" Background="#F8FAF9" Padding="8" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3E1" BorderThickness="0,1,0,0" Padding="24,11">
            <TextBlock x:Name="FooterStatusText" Text="Initializing native controller…" Foreground="{StaticResource TextSecondary}" />
        </Border>
    </Grid>
</Window>
